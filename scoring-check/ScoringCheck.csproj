<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs LQX's own compiled scoring code. The LQX files are x86-only .NET Framework 4.x assemblies, so this targets
       net48/x86 and runs on Windows. Point LqxDir at a folder holding Console.exe, Versent.LQX.Core.dll and log4net.dll
       from an LQX install (they are not included in this repo). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>ScoringCheck</AssemblyName>
    <LqxDir Condition="'$(LqxDir)' == ''">$(MSBuildThisFileDirectory)lqx</LqxDir>
    <NoWarn>MSB3277;MSB3245</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Console"><HintPath>$(LqxDir)/Console.exe</HintPath></Reference>
    <Reference Include="Versent.LQX.Core"><HintPath>$(LqxDir)/Versent.LQX.Core.dll</HintPath></Reference>
    <Reference Include="log4net"><HintPath>$(LqxDir)/log4net.dll</HintPath></Reference>
  </ItemGroup>
</Project>
